<div class="scoreboard-view-volleyball">
    <div class="scoreboard-img-container">
        <input id="team1" class="team scoreboard" type="text" value="team1"></input>
        <input id="set1" class="set scoreboard" type="number" value="0" min="0"></input>
        <input id="score1" class="score scoreboard" type="number" value="0" min="0"></input>
        <input id="score2" class="score scoreboard" type="number" value="0" min="0"></input>
        <input id="set2" class="set scoreboard" type="number" value="0" min="0"></input>
        <input id="team2" class="team scoreboard" type="text" value="team2"></input>
    </div>
</div>
<div class="button-container">
    <div class="button-row1">
        <button id="set1_plus_1" class="button_set set_team_1" name="button_set1_plus">+ 1</button>
        <button id="team1_plus_1" class="button_score score_team_1" name="button">+ 1</button>
        <button id="team2_plus_2" class="button_score score_team_2" name="button">+ 1</button>
        <button id="set2_plus_2" class="button_set set_team_2" name="button_set2_plus">+ 1</button>
    </div>
    <br>
    <div class="button-row2">
        <button id="set1_minus_1" class="button_set set_team_1" name="button_set1_minus">- 1</button>
        <button id="team1_minus_1" class="button_score score_team_1" name="button">- 1</button>
        <button id="team2_minus_2" class="button_score score_team_2" name="button">- 1</button>
        <button id="set2_minus_2" class="button_set set_team_2" name="button_set2_minus">- 1</button>
    </div>
    <br>
    <button class="reset" id="resetScore" type="button">Reset</button>
</div>



<script src="/socket.io/socket.io.js"></script>
<script src="/public/js/score_input_view_volleyball.js"></script>